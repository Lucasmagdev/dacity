# Audacity Game payment server. Copy to .env for local runs; on Railway set these under Variables.
# SECRETS: never commit the real values, never put them in the web app or in any VITE_ variable.

# devnet while testing, mainnet-beta at launch
SOLANA_NETWORK=devnet
# Paid RPC strongly recommended (Helius / Triton / QuickNode). Empty = public RPC (rate-limited).
SOLANA_RPC_URL=

# Supabase (secret key: bypasses RLS)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Reward Pool wallet: receives USDC deposits, pays USDC withdrawals (players pay the network fee)
POOL_WALLET_ADDRESS=
POOL_WALLET_SECRET_KEY=

# AMMO wallet: receives AMMO deposits, pays AMMO withdrawals, burns spent AMMO (keep ~0.05 SOL in it for burn fees)
AMMO_WALLET_ADDRESS=
AMMO_WALLET_SECRET_KEY=

# $AMMO mint address. Leave empty until launch (price feed, AMMO deposits/withdrawals and burns stay off).
AMMO_MINT=

# Sites allowed to call the API (comma separated)
WEB_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:5317

# Optional: Helius webhook → POST https://<this server>/webhooks/helius with this value as the auth header
HELIUS_WEBHOOK_SECRET=

# Optional tuning
BURN_MIN_AMMO=1000
# WORKERS=0 → only the API runs on this instance
WORKERS=1
