# Deployer key (use a dedicated wallet; never commit .env)
PRIVATE_KEY=

# Optional private RPCs (public ones are rate-limited)
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Official Circle USDC on Robinhood Chain. REQUIRED on mainnet.
# Get it from Robinhood's official token contracts list, not from third-party lists.
# Empty on testnet/local -> the script deploys MockUSDC (with faucet).
USDC_ADDRESS=

# Gangster NFT metadata base URI (e.g. ipfs://<cid>/)
GANGSTER_BASE_URI=
