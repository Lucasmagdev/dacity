# devnet (default) | mainnet-beta
VITE_SOLANA_NETWORK=devnet

# Private Solana RPC (Helius, QuickNode, Triton...). Public RPCs are heavily rate-limited.
VITE_SOLANA_RPC=

# Game wallets: PUBLIC ADDRESSES ONLY. Private keys never go in this file
# (everything prefixed VITE_ is shipped to every visitor). Keys live in server/.env.
VITE_POOL_WALLET=DVJWuCVnUFK4uQGb9xSeG7RVB5R7c8cukPBJ9ZD5ud96
VITE_AMMO_WALLET=8VPpLodX2qZsNNZqUqyhuKepSguFNQKGMubddBqKQbse
VITE_TOKEN_DEPLOYER=25aeNm5Zk2tGYVS1awPEonmPZoLSgA7BX4XahUuRseJd

# Hero countdown target (ISO 8601)
VITE_SEASON_START=2026-12-12T20:00:00Z

# Wallets allowed into the admin panel (#/admin), comma-separated Solana addresses.
# UI gate only: real permissions must be enforced by the server.
VITE_ADMIN_WALLETS=

# 1 = browser-only mock (default) · 0 = play against Supabase (wallet sign-in, real database)
VITE_MOCK=1

# Supabase: the URL and the PUBLISHABLE key only. The secret key goes in server/.env, never here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
