# testnet | mainnet | local (hardhat node on 127.0.0.1:8545)
VITE_NETWORK=testnet

# Free at https://cloud.reown.com — enables WalletConnect / mobile wallets.
# Without it, browser-extension wallets (MetaMask, Rabby...) still work.
VITE_WALLETCONNECT_PROJECT_ID=

# Hero countdown target (ISO 8601)
VITE_SEASON_START=2026-12-12T20:00:00Z

# Optional private RPCs
VITE_ROBINHOOD_RPC=
VITE_ROBINHOOD_TESTNET_RPC=
