# devnet (default) | mainnet-beta
VITE_SOLANA_NETWORK=devnet

# Private Solana RPC (Helius, QuickNode, Triton...). Public RPCs are heavily rate-limited.
VITE_SOLANA_RPC=

# Game control wallet (public address) that receives USDC / $AMMO deposits. Set at launch.
VITE_CONTROL_WALLET=

# Hero countdown target (ISO 8601)
VITE_SEASON_START=2026-12-12T20:00:00Z

# Wallets allowed into the admin panel (#/admin), comma-separated Solana addresses.
# UI gate only: real permissions must be enforced by the server.
VITE_ADMIN_WALLETS=

# 0 = turn off the browser-only mock (once the Supabase backend is wired in)
VITE_MOCK=1
