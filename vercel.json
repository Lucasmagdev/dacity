{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "jackpot\\..*" }], "destination": "/jackpot.html" }
  ]
}
